# ===========================================================================
#  OSS Competency Platform - configuration
#
#  Copy to .env and edit:   copy .env.example .env
#  .env is gitignored, so your keys never reach the repository.
#
#  Real environment variables take precedence over this file, so
#  docker-compose and CI can still override anything here.
# ===========================================================================

# --- Database --------------------------------------------------------------
# SQLite needs no setup and is what start.bat uses.
DATABASE_URL=sqlite:///./sih_oss.db
# docker-compose sets this instead:
# DATABASE_URL=postgresql+psycopg://sih:sih@localhost:5432/sih_oss

# --- Course catalogue ------------------------------------------------------
# "mock"    - local sandbox speaking the Sunbird contract, zero external calls
# "sunbird" - a real Sunbird gateway (needs Karmayogi Bharat credentials,
#             which this repository does not ship)
KARMAYOGI_MODE=mock
# SUNBIRD_BASE=http://localhost:8000/mock-sunbird
# SUNBIRD_API_KEY=
# SUNBIRD_USER_TOKEN=

# --- Question generation and the course tutor ------------------------------
# Used by the "upload a PDF and generate a quiz" feature and by the course
# tutor. Module checkpoint quizzes come from the authored question bank and
# never call an LLM.
#
#   stub    - offline and deterministic; no key needed, but the questions are
#             weak (it reuses the same three wrong answers every time)
#   gemini  - needs GEMINI_API_KEY below
#   openai  - needs OPENAI_API_KEY below
#   ollama  - local model, no key
#
# This file IS loaded: app/config.py reads it at startup, and real environment
# variables still take precedence.
#
# Gemini model names retire quickly. gemini-2.0-flash 404s, and gemini-2.5-flash
# reports "no longer available to new users" on a freshly issued key. The default
# is gemini-3.1-flash-lite; set LLM_MODEL to pin a different one.
LLM_PROVIDER=stub

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Leave blank to use the code default (gemini-3.1-flash-lite).
# LLM_MODEL=gemini-3.1-flash-lite

# OPENAI_API_KEY=
# OLLAMA_BASE=http://localhost:11434

# --- Sign-in ---------------------------------------------------------------
# Seeded accounts: u-admin-meera / admin123 (administrator)
#                  every other officer / officer123 (learner only)
JWT_SECRET=change-me-before-deploying
JWT_TTL_MINUTES=720

# Lets an X-User-Id header pick a seeded officer without logging in, so a demo
# can switch profiles freely. It never grants administrator access.
# Set to false to require a real token everywhere.
DEMO_HEADER_AUTH=true

# Password hashing cost. Lower only in tests, never in a deployment.
# PBKDF2_ITERATIONS=200000

# --- Misc ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Largest PDF/TXT accepted by the upload endpoint. Default 8 MB.
# MAX_UPLOAD_BYTES=8388608
