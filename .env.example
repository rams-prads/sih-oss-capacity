# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every default below runs the demo fully offline.
# ---------------------------------------------------------------------------

# Database. SQLite needs no setup; docker-compose sets the Postgres URL.
DATABASE_URL=sqlite:///./sih_oss.db
# DATABASE_URL=postgresql+psycopg://sih:sih@localhost:5432/sih_oss

# Catalogue backend: "mock" (sandbox, offline) or "sunbird" (live contract).
# Live iGOT requires Karmayogi Bharat credentials, which are not shipped here.
KARMAYOGI_MODE=mock
# SUNBIRD_BASE=http://localhost:8000/mock-sunbird
# SUNBIRD_API_KEY=
# SUNBIRD_USER_TOKEN=

# MCQ generation and the course tutor: "stub" (offline, deterministic),
# "openai", "gemini" or "ollama". This file IS loaded now - app/config.py reads
# it at startup, and real environment variables still take precedence.
#
# Gemini model names retire quickly: gemini-2.0-flash 404s and gemini-2.5-flash
# reports "no longer available to new users" on a freshly issued key. The default
# is gemini-3.1-flash-lite; set LLM_MODEL to pin a different one.
LLM_PROVIDER=stub
# LLM_MODEL=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE=http://localhost:11434

# App auth. Sunbird/Keycloak federation is out of scope; the app signs in with
# an officer id and password. Seeded: u-admin-meera/admin123 (administrator),
# every other officer/officer123 (learner only).
JWT_SECRET=change-me
JWT_TTL_MINUTES=720

# Lets an X-User-Id header pick a seeded officer without logging in, so a demo
# can switch profiles freely. It never grants administrator access. Set false to
# require a real token everywhere.
DEMO_HEADER_AUTH=true

# PBKDF2 cost. Lower only in tests; never in a deployment.
# PBKDF2_ITERATIONS=200000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
