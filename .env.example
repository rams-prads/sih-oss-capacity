# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every default below runs the demo fully offline.
# ---------------------------------------------------------------------------

# Database. SQLite needs no setup; docker-compose sets the Postgres URL.
DATABASE_URL=sqlite:///./sih_oss.db
# DATABASE_URL=postgresql+psycopg://sih:sih@localhost:5432/sih_oss

# Catalogue backend: "mock" (sandbox, offline) or "sunbird" (live contract).
# Live iGOT requires Karmayogi Bharat credentials, which are not shipped here.
KARMAYOGI_MODE=mock
# SUNBIRD_BASE=http://localhost:8000/mock-sunbird
# SUNBIRD_API_KEY=
# SUNBIRD_USER_TOKEN=

# MCQ generation: "stub" (offline, deterministic), "openai", "gemini", "ollama".
LLM_PROVIDER=stub
# LLM_MODEL=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE=http://localhost:11434

# App auth (Sunbird/Keycloak auth is out of scope and mocked).
JWT_SECRET=change-me
JWT_TTL_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
